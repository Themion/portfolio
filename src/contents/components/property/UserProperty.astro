---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

import User from "./User.astro";

interface Props extends NotionPropertyProps<"created_by" | "last_edited_by"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;

const user = property.type === "created_by" ? property.created_by : property.last_edited_by;
---

<User user={user} htmlProps={htmlProps} />
