---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

import TimeRange from "../rich-text/TimeRange.astro";

interface Props extends NotionPropertyProps<"formula"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
const { formula } = property;
---

{
  formula.type === "boolean" && formula.boolean !== null && (
    <input type="checkbox" checked={formula.boolean} disabled {...htmlProps} />
  )
}
{
  formula.type === "number" && formula.number !== null && (
    <span {...htmlProps}>{formula.number}</span>
  )
}
{
  formula.type === "string" && formula.string !== null && (
    <span {...htmlProps}>{formula.string}</span>
  )
}
{
  formula.type === "date" && formula.date !== null && (
    <TimeRange start={formula.date.start} end={formula.date.end} htmlProps={htmlProps} />
  )
}
