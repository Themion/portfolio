---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"multi_select"> {
  htmlProps?: HTMLAttributes<"ul">;
}

const { property, htmlProps } = Astro.props;
---

<ul {...htmlProps}>
  {property.multi_select.map((option) => <li data-notion-color={option.color}>{option.name}</li>)}
</ul>
