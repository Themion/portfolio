---
import type { NotionPropertyComponents, NotionPropertyProps, Property } from "~/contents/types";
import type { AstroComponent } from "~/types";

import Checkbox from "./Checkbox.astro";
import DateValue from "./DateValue.astro";
import Email from "./Email.astro";
import Files from "./Files.astro";
import Formula from "./Formula.astro";
import MultiSelect from "./MultiSelect.astro";
import NumberValue from "./NumberValue.astro";
import People from "./People.astro";
import PhoneNumber from "./PhoneNumber.astro";
import Place from "./Place.astro";
import Relation from "./Relation.astro";
import RichTextValue from "./RichTextValue.astro";
import Rollup from "./Rollup.astro";
import Select from "./Select.astro";
import Status from "./Status.astro";
import Timestamp from "./Timestamp.astro";
import Title from "./Title.astro";
import UniqueId from "./UniqueId.astro";
import UnsupportedProperty from "./UnsupportedProperty.astro";
import Url from "./Url.astro";
import UserProperty from "./UserProperty.astro";
import Verification from "./Verification.astro";

// `button` is left unmapped — it carries no data (`{ type: 'button', button: {} }`), so the
// `UnsupportedProperty` fallback's message is already the correct thing to show for it.
const defaultPropertyComponents = {
  checkbox: Checkbox,
  // UserProperty/Timestamp handle both their slots, so narrowing per slot here is safe.
  created_by: UserProperty as AstroComponent<NotionPropertyProps<'created_by'>>,
  created_time: Timestamp as AstroComponent<NotionPropertyProps<'created_time'>>,
  date: DateValue,
  email: Email,
  files: Files,
  formula: Formula,
  last_edited_by: UserProperty as AstroComponent<NotionPropertyProps<'last_edited_by'>>,
  last_edited_time: Timestamp as AstroComponent<NotionPropertyProps<'last_edited_time'>>,
  multi_select: MultiSelect,
  number: NumberValue,
  people: People,
  phone_number: PhoneNumber,
  place: Place,
  relation: Relation,
  rich_text: RichTextValue,
  rollup: Rollup,
  select: Select,
  status: Status,
  title: Title,
  unique_id: UniqueId,
  url: Url,
  verification: Verification,
} satisfies NotionPropertyComponents;

interface Props {
  property: Property;
  components?: NotionPropertyComponents;
}

const { property, components = {} } = Astro.props;

const resolvedComponents = {
  ...defaultPropertyComponents,
  ...components,
};

// property.type is only known at runtime, so its exact prop type can't be proven here — trust it.
const Component = (resolvedComponents[property.type] ??
  UnsupportedProperty) as AstroComponent<NotionPropertyProps>;
---

<Component property={property} components={components} />
