---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps, Property } from "~/contents/types";

import TimeRange from "../rich-text/TimeRange.astro";
import NotionProperty from "./NotionProperty.astro";

interface Props extends NotionPropertyProps<"rollup"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, components, htmlProps } = Astro.props;
const { rollup } = property;
---

{rollup.type === "number" && rollup.number !== null && <span {...htmlProps}>{rollup.number}</span>}
{
  rollup.type === "date" && rollup.date !== null && (
    <TimeRange start={rollup.date.start} end={rollup.date.end} htmlProps={htmlProps} />
  )
}
{
  rollup.type === "array" && (
    <ul {...htmlProps}>
      {rollup.array.map((item) => (
        <li>
          {/* Rollup array items are property values without the `.id` wrapper, which no component reads. */}
          <NotionProperty property={item as unknown as Property} components={components} />
        </li>
      ))}
    </ul>
  )
}
