---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"status"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
---

{
  property.status && (
    <span data-notion-color={property.status.color} {...htmlProps}>
      {property.status.name}
    </span>
  )
}
