---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

import { RichText } from "../rich-text";

interface Props extends NotionPropertyProps<"title"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
---

<RichText richText={property.title} htmlProps={htmlProps} />
