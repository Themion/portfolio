---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"unique_id"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
const { prefix, number } = property.unique_id;
---

{number !== null && <span {...htmlProps}>{prefix ? `${prefix}-${number}` : number}</span>}
