---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

import User from "./User.astro";

interface Props extends NotionPropertyProps<"people"> {
  htmlProps?: HTMLAttributes<"ul">;
}

const { property, htmlProps } = Astro.props;
---

<ul {...htmlProps}>
  {
    property.people.map((user) => (
      <li>
        <User user={user} />
      </li>
    ))
  }
</ul>
