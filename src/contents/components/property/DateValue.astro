---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

import TimeRange from "../rich-text/TimeRange.astro";

interface Props extends NotionPropertyProps<"date"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
---

{
  property.date && (
    <TimeRange start={property.date.start} end={property.date.end} htmlProps={htmlProps} />
  )
}
