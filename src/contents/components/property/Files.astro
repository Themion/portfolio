---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"files"> {
  htmlProps?: HTMLAttributes<"ul">;
}

const { property, htmlProps } = Astro.props;
---

<ul {...htmlProps}>
  {
    property.files.map((file) => (
      <li>
        <a href={file.type === "external" ? file.external.url : file.file.url}>{file.name}</a>
      </li>
    ))
  }
</ul>
