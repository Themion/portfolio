---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"select"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
---

{
  property.select && (
    <span data-notion-color={property.select.color} {...htmlProps}>
      {property.select.name}
    </span>
  )
}
