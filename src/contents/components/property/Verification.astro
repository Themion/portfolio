---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

import User from "./User.astro";

interface Props extends NotionPropertyProps<"verification"> {
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
const { verification } = property;
---

{
  verification && (
    <span data-state={verification.state} {...htmlProps}>
      {verification.state}
      {verification.verified_by && <User user={verification.verified_by} />}
    </span>
  )
}
