---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"relation"> {
  htmlProps?: HTMLAttributes<"ul">;
}

const { property, htmlProps } = Astro.props;
---

<ul {...htmlProps}>
  {
    // No title without a separate fetch, so link by id instead of a resolved title.
    property.relation.map((item) => (
      <li>
        <a href={`https://www.notion.so/${item.id.replaceAll("-", "")}`}>{item.id}</a>
      </li>
    ))
  }
</ul>
