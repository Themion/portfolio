---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyProps } from "~/contents/types";

interface Props extends NotionPropertyProps<"place"> {
  // `href` is derived from the property's value — letting a caller override it would point the
  // link somewhere other than what's actually displayed.
  htmlProps?: Omit<HTMLAttributes<"a">, "href">;
}

const { property, htmlProps } = Astro.props;
const { place } = property;
---

{
  place && (
    <a href={`https://www.google.com/maps?q=${place.lat},${place.lon}`} {...htmlProps}>
      {place.name ?? place.address ?? `${place.lat}, ${place.lon}`}
    </a>
  )
}
