---
import type { HTMLAttributes } from "astro/types";

import type { NotionPropertyComponents, Property } from "~/contents/types";

interface Props {
  property: Property;
  components?: NotionPropertyComponents;
  htmlProps?: HTMLAttributes<"span">;
}

const { property, htmlProps } = Astro.props;
---

<span data-notion-property-type={property.type} {...htmlProps}>
  Unsupported Notion property: {property.type}
</span>
