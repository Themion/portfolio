---
import type { Block, NotionBlockComponents } from '~/contents/types';

import NotionBlocks from './NotionBlocks.astro';

interface Props {
  block: Block;
  components: NotionBlockComponents;
}

const { block, components } = Astro.props;
---

<p class="notion-block-unsupported" data-notion-block-type={block.type}>
  Unsupported Notion block: {block.type}
</p>
{block.has_children && <NotionBlocks blocks={block.children} components={components} />}
