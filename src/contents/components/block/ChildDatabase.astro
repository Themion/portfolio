---
import type { NotionBlockProps } from '~/contents/types';

type Props = NotionBlockProps<'child_database'>;

const { block } = Astro.props;

const href = `https://www.notion.so/${block.id.replaceAll('-', '')}`;
---

<a class="notion-block-child-database" href={href}>{block.child_database.title}</a>
