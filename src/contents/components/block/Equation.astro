---
import type { HTMLAttributes } from "astro/types";

import type { NotionBlockProps } from "~/contents/types";

import Equation from "../rich-text/Equation.astro";

interface Props extends NotionBlockProps<"equation"> {
  htmlProps?: Omit<HTMLAttributes<"img">, "src" | "alt">;
}

const { block, htmlProps } = Astro.props;
---

<Equation expression={block.equation.expression} htmlProps={htmlProps} />
