---
import type { NotionBlockProps } from '~/contents/types';

import NotionBlocks from './NotionBlocks.astro';

type Props = NotionBlockProps<'synced_block'>;

const { block, components } = Astro.props;
---

<div class="notion-block-synced-block">
  {block.has_children && <NotionBlocks blocks={block.children} components={components} />}
</div>
