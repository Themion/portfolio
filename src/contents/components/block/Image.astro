---
import type { NotionBlockProps } from '~/contents/types';
import { downloadFile } from '~/contents/utils/download-file';

import { RichText } from '../rich-text';

type Props = NotionBlockProps<'image'>;

const { block } = Astro.props;

const src =
  block.image.type === 'external' ? await downloadFile(block.image.external.url) : await downloadFile(block.image.file.url);
const hasCaption = block.image.caption.length > 0;
const alt = block.image.caption.map((richText) => richText.plain_text).join('');
---

<figure class="notion-block-figure">
  <img loading="lazy" src={src} alt={alt || undefined} />
  {
    hasCaption && (
      <figcaption class="notion-block-figcaption">
        <RichText richText={block.image.caption} />
      </figcaption>
    )
  }
</figure>
