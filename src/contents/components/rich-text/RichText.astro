---
import type { RichTextItemResponse } from "@notionhq/client";
import type { HTMLAttributes } from "astro/types";

import TextRun from "./TextRun.astro";

interface Props {
  richText: RichTextItemResponse[];
  htmlProps?: HTMLAttributes<"span">;
}

const { richText, htmlProps } = Astro.props;
---

<span {...htmlProps}>{richText.map((item) => <TextRun item={item} />)}</span>
