---
import TimeRange from '../rich-text/TimeRange.astro';
import NotionProperty from './NotionProperty.astro';
import type { NotionPropertyProps, Property } from './types';

type Props = NotionPropertyProps<'rollup'>;

const { property, components } = Astro.props;
const { rollup } = property;
---

{rollup.type === 'number' && rollup.number !== null && <span class="notion-property-rollup">{rollup.number}</span>}
{rollup.type === 'date' && rollup.date !== null && <TimeRange start={rollup.date.start} end={rollup.date.end} />}
{
  rollup.type === 'array' && (
    <ul class="notion-property-rollup">
      {rollup.array.map((item) => (
        <li>
          {/* Rollup array items are property values without the `.id` wrapper, which no component reads. */}
          <NotionProperty property={item as unknown as Property} components={components} />
        </li>
      ))}
    </ul>
  )
}
