---
import type { NotionPropertyProps } from './types';
import User from './User.astro';

type Props = NotionPropertyProps<'verification'>;

const { property } = Astro.props;
const { verification } = property;
---

{
  verification && (
    <span class="notion-property-verification" data-state={verification.state}>
      {verification.state}
      {verification.verified_by && <User user={verification.verified_by} />}
    </span>
  )
}
