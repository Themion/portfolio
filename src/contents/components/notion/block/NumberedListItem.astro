---
import { RichText } from '../rich-text';
import NotionBlocks from './NotionBlocks.astro';
import type { NotionBlockProps } from './types';

type Props = NotionBlockProps<'numbered_list_item'>;

const { block, components } = Astro.props;

const color = block.numbered_list_item.color;
---

<li data-notion-color={color !== 'default' ? color : undefined}>
  <span>
    <RichText richText={block.numbered_list_item.rich_text} />
  </span>
  {block.has_children && <NotionBlocks blocks={block.children} components={components} />}
</li>
