---
import { getCollection } from "astro:content";

import { NotionBlocks, NotionProperty } from "~/contents/components";

import TechStackIcon from "./TechStackIcon.astro";

const techStacks = await getCollection("techStack");
---

<section>
  <h2>Tech Stacks</h2>
  <div class="flex flex-row flex-wrap gap-4">
    {
      techStacks.map((page) => {
        const { properties } = page.data;
        const dialogId = `skill-modal-${page.id}`;

        return (
          <Fragment>
            <button
              type="button"
              class="flex flex-row items-center gap-2 rounded border border-neutral-200 p-2"
              data-skill-trigger={dialogId}
              aria-haspopup="dialog"
            >
              <TechStackIcon property={properties["아이콘"]} />
              <NotionProperty property={properties["기술명"]} />
            </button>
            <dialog id={dialogId} class="skill-modal max-w-md rounded p-6 backdrop:bg-black/50">
              <div class="flex flex-row items-center justify-between gap-4">
                <div class="flex flex-row items-center gap-2">
                  <TechStackIcon property={properties["아이콘"]} />
                  <NotionProperty property={properties["기술명"]} />
                </div>
                <form method="dialog">
                  <button
                    type="submit"
                    autofocus
                    aria-label="닫기"
                    class="rounded px-2 py-1 text-neutral-500 hover:bg-neutral-100"
                  >
                    ✕
                  </button>
                </form>
              </div>
              <div class="mt-4">
                <NotionBlocks blocks={page.data.children} />
              </div>
            </dialog>
          </Fragment>
        );
      })
    }
  </div>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-skill-trigger]');

  for (const trigger of triggers) {
    const dialog = document.getElementById(trigger.dataset.skillTrigger ?? '');
    if (!(dialog instanceof HTMLDialogElement)) continue;

    trigger.addEventListener('click', () => dialog.showModal());
    // `<dialog>` has no built-in backdrop-close — a click landing on the dialog itself hit the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
