---
import { getCollection } from "astro:content";

import { DateValue, Select, Title } from "~/contents/components";
import RichTextValue from "~/contents/components/property/RichTextValue.astro";

const educations = await getCollection("education");
---

<section>
  {
    educations.map((education) => (
      <div>
        <h4>
          <Title property={education.data.properties["학교명"]} />
        </h4>
        <p class="text-md text-neutral-400">
          <DateValue property={education.data.properties["시작일"]} />
          {` ~ `}
          {education.data.properties["종료일"].date ? (
            <DateValue property={education.data.properties["종료일"]} />
          ) : (
            "(재직중)"
          )}
          {" | "}
          <Select property={education.data.properties["학위"]} />
          {" | "}
          <RichTextValue property={education.data.properties["전공"]} />
        </p>
      </div>
    ))
  }
</section>
