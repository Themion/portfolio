---
import { type CollectionEntry } from "astro:content";
import { twMerge } from "tailwind-merge";

import { Title } from "~/contents/components";
import NotionBlocks from "~/contents/components/block/NotionBlocks.astro";

import TaskBadge from "./TaskBadge.astro";

interface Props {
  task: CollectionEntry<"task">;
}

const { task } = Astro.props;
---

<details
  class={twMerge(
    "group/task",
    "[&::details-content]:h-0 [&::details-content]:overflow-hidden open:[&::details-content]:h-auto", // state 별 height 지정
    "[interpolate-size:allow-keywords]", // height 보간
    "[&::details-content]:transition-discrete", // content-visibility 조정
    "[&::details-content]:transition-[height,content-visibility] [&::details-content]:duration-(--duration)", // 애니메이션 설정
    "[&::details-content]:ease-in-out [&_*::after]:ease-in-out", // 애니메이션 timing function
  )}
  style={{
    "--duration": "100ms",
  }}
>
  <summary
    class={twMerge(
      "flex flex-row items-center gap-2 rounded p-1",
      "cursor-pointer hover:bg-notion/4",
      "before:content-['▶'] before:text-(length:--text-arrow-sm) before:text-notion/40",
      "before:duration-(--duration) group-open/task:before:rotate-90", // after 애니메이션 추가
    )}
  >
    <h6 class="text-(length:--text-body-sm) font-medium">
      <Title
        property={task.data.properties["제목"]}
        htmlProps={{
          style: {
            paddingRight: "6px",
            border: "1px solid transparent",
          },
        }}
      />
      <TaskBadge property={task.data.properties["구분"]} />
    </h6>
  </summary>
  <div class="pl-6 text-(length:--text-body-sm) leading-[1.6]">
    <NotionBlocks blocks={task.data.children} />
  </div>
</details>
