---
import { twMerge } from "tailwind-merge";

interface Props {
  label?: string;
}

const { label = "" } = Astro.props;
---

<label class="group flex flex-row items-center gap-2 text-sm text-notion/70 [&_*]:ease-in-out">
  <span
    class="relative h-(--height) w-(--width) rounded-full bg-notion/20 transition-colors group-has-[input:checked]:bg-blue-500"
    style={{
      "--width": "32px",
      "--height": "18px",
      "--padding": "2px",
    }}
  >
    <span
      class={twMerge(
        "size-(--size) rounded-full bg-white shadow-[0_1px_2px_rgba(0,0,0,0.25)]",
        "absolute top-1/2 -translate-y-1/2",
        "left-(--padding) group-has-[input:checked]:left-[calc(var(--width)-var(--padding)-var(--size))]",
        "duration-(--duration) transition-[left]",
      )}
      style={{
        "--size": "calc(var(--height) - var(--padding) * 2)",
      }}></span>
  </span>
  <input type="checkbox" data-filter="project" class="hidden" />
  <span>{label}</span>
</label>
