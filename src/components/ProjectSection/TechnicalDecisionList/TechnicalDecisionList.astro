---
import { type CollectionEntry, getEntries } from "astro:content";
import { twMerge } from "tailwind-merge";

import TechnicalDecisionItem from "./TechnicalDecisionItem.astro";

interface Props {
  project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const decisions = await getEntries(project.data.properties["기술적 의사결정"].relation);
---

<ul class="rounded-lg border border-neutral-400 bg-neutral-100 px-6 py-2">
  {
    decisions.map((decision) => (
      <li
        class={twMerge(
          "border-b border-neutral-300 last-of-type:border-b-0",
          "-mx-(--underline-overflow) px-(--underline-overflow) py-1",
        )}
        style={{
          "--underline-overflow": "8px",
        }}
      >
        <TechnicalDecisionItem decision={decision} />
      </li>
    ))
  }
</ul>
