---
import { type CollectionEntry } from "astro:content";

import { getSortedEntries } from "~/utils/get-sorted-entries";

import TechnicalDecisionItem from "./TechnicalDecisionItem.astro";

interface Props {
  project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const decisions = await getSortedEntries(
  project.data.properties["기술적 의사결정"].relation,
  (decision) => decision.data.properties["순서"].number ?? 0,
);
---

<ul>
  {
    decisions.map((decision) => (
      <li>
        <TechnicalDecisionItem decision={decision} />
      </li>
    ))
  }
</ul>
