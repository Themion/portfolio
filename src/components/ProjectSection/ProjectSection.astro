---
import { getCollection } from "astro:content";

import ProjectList from "./ProjectList.astro";
import Toggle from "./Toggle.astro";

const companies = await getCollection("company");
---

<section
  class="flex flex-col gap-(--gap)"
  style={{
    "--duration": "300ms",
    "--gap": "24px",
  }}
>
  <div class="flex flex-row items-center justify-between">
    <h2 class="text-3xl font-bold">Project</h2>
    <Toggle label="핵심 프로젝트만 보기" />
  </div>
  {companies.map((company) => <ProjectList company={company} />)}
</section>
