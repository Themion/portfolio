---
import { type CollectionEntry } from "astro:content";

import { DateValue, Title } from "~/contents/components";
import { getSortedEntries } from "~/utils/get-sorted-entries";

import ProjectItem from "./ProjectItem.astro";

interface Props {
  company: CollectionEntry<"company">;
}

const { company } = Astro.props;

const projects = await getSortedEntries(
  company.data.properties["연결 프로젝트"].relation,
  (project) => project.data.properties["순서"].number ?? 0,
);
---

<div class="grid grid-cols-1 md:grid-cols-[250px_1fr]">
  <div class="sticky top-0 flex h-fit flex-col gap-2">
    <h3 class="text-xl font-semibold">
      <Title property={company.data.properties["회사명"]} />
    </h3>
    <p class="text-md text-neutral-400">
      <DateValue property={company.data.properties["입사일"]} />
      {` ~ `}
      {
        company.data.properties["퇴사일"].date ? (
          <DateValue property={company.data.properties["퇴사일"]} />
        ) : (
          "(재직중)"
        )
      }
    </p>
  </div>
  <div class="flex flex-col gap-6">
    {projects.map((project) => <ProjectItem project={project} />)}
  </div>
</div>
