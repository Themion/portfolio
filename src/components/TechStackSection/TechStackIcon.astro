---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

import type { Property } from "~/contents/types";
import { downloadFile } from "~/contents/utils/download-file";

type Props = {
  property: Extract<Property, { type: "files" }>;
  htmlProps?: Omit<HTMLAttributes<"img">, "src">;
};

const { property, htmlProps: { class: customClass, alt: customAlt, ...props } = {} } = Astro.props;

const imgProps = await Promise.all(
  property.files.map(async (file): Promise<{ src: string; alt: string }> => {
    const alt = file.name;
    switch (file.type) {
      case "external":
        return { src: file.external.url, alt };
      case "file":
        return { src: await downloadFile(file.file.url), alt };
    }
  }),
);
---

{
  imgProps.map(({ src, alt }) => (
    <img
      src={src}
      alt={customAlt ?? alt}
      class={twMerge("size-full object-contain", customClass)}
      {...props}
    />
  ))
}
