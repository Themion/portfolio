---
import { getSortedCollections } from "~/utils/get-sorted-collections";

import TechStackGroup from "./TechStackGroup.astro";

const techStackTypes = await getSortedCollections(
  "techStackType",
  ({ data }) => data.properties["순서"].number ?? Infinity,
);
---

<section class="flex flex-col gap-6">
  <h2 class="text-3xl font-bold">Tech Stacks</h2>
  <div class="flex flex-col gap-4">
    {techStackTypes.map((techStackType) => <TechStackGroup techStackType={techStackType} />)}
  </div>
</section>
