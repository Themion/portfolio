---
import { type CollectionEntry, getEntries } from "astro:content";

import { Title } from "~/contents/components";

import TechStackCard from "./TechStackCard.astro";

interface Props {
  techStackType: CollectionEntry<"techStackType">;
}

const { techStackType } = Astro.props;

const techStacks = await getEntries(techStackType.data.properties["사용 기술"].relation);
---

<div class="flex flex-col gap-2">
  <h3 class="text-xl font-semibold">
    <Title property={techStackType.data.properties["분류명"]} />
  </h3>
  <div class="flex flex-row flex-wrap gap-2">
    {techStacks.map((page) => <TechStackCard page={page} />)}
  </div>
</div>
